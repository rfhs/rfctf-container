#!/bin/bash -x
set -eu -o pipefail
export DEBUG="${DEBUG:-}"

missing_tools=""
for tool in dirname seq sleep; do
  command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool}"
done
if [ -n "${missing_tools}" ]; then
  printf '%s: required commands not found:%s\n' "${0##*/}" "${missing_tools}"
  exit 1
fi

export CONTAINER_NAME="kali-contestant"
export CONTAINER_IMAGE="ghcr.io/rfhs/kali"
CONTAINER_PHYS="$(seq 34 37)"
export CONTAINER_PHYS
export CONTAINER_NETWORKS="contestant"
export SSH_PORT="2202"
export VNC_PORT="8802"

"$(dirname "${0}")"/rfhs-container-init
sleep 20
