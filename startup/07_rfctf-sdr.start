#!/bin/bash
set -eu -o pipefail
export DEBUG="${DEBUG:-}"

missing_tools=""
for tool in dirname sleep; do
  command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool}"
done
if [ -n "${missing_tools}" ]; then
  printf '%s: required commands not found:%s\n' "${0##*/}" "${missing_tools}"
  exit 1
fi

export CONTAINER_NAME="rfctf-sdr"
export CONTAINER_IMAGE="rfhs/rfctf-sdr"
CONTAINER_PHYS=""
export CONTAINER_PHYS
export CONTAINER_NETWORKS=""

"$(dirname "${0}")"/rfhs-container-init
sleep 10
