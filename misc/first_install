#!/bin/sh
set -eux

# needs script command...: names the commands script runs that aren't
# installed
unmet=""
needs() {
  script="${1}"
  shift
  missing_tools=""
  for tool in "$@"; do
    command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool}"
  done
  if [ -n "${missing_tools}" ]; then
    printf '%s: required commands not found:%s\n' "${script}" "${missing_tools}"
    unmet=1
  fi
}
needs first_install apt-cache apt-get awk cat chmod cp cut dirname grep ln mkdir modinfo sed sleep uname
# docker_userns_remap, which this runs once docker is installed
needs docker_userns_remap awk getent grep mkdir python3 sed sleep touch useradd
# The startup scripts this links into /etc/local.d don't check for
# themselves, so a command one of them starts to run has to be added here.
# docker, iw and aws aren't checked, as this installs them below, and
# 07_rfctf-sdr.start and 08_fosphor_knob.start aren't linked.
needs rfhs-container-init awk cat chown dirname find grep ip mkdir mount mountpoint rm sed sleep stat touch
needs fixphy.sh cat find seq
needs 00_aws_set_dns.start cat
needs 00_docker_check.start awk shutdown sleep
needs 00_radio_init.start cat dirname grep lsmod modinfo modprobe sleep
needs 01_openwrt.start awk dirname seq sleep
needs 02_rfctf-client.start dirname seq sleep
needs 03_pentoo-contestant.start dirname seq sleep
needs 04_kali-contestant.start dirname seq sleep
needs 05_parrot-contestant.start dirname seq sleep
needs 06_blackarch-contestant.start dirname seq sleep
needs 97_nginx_proxy.start cat chown mkdir sleep
needs 98_nginx_proxy_ssl.start cat sleep
needs 99_notify-scoreboard.start cat
on_ec2=""
if [ -r "/sys/devices/virtual/dmi/id/board_vendor" ] && [ "$(cat /sys/devices/virtual/dmi/id/board_vendor)" = 'Amazon EC2' ]; then
  on_ec2=1
fi
# they only use these on EC2
if [ -n "${on_ec2}" ]; then
  needs 00_aws_set_dns.start cloud-init curl
  needs 99_notify-scoreboard.start curl uuidgen
  # where the release has no awscli package
  needs first_install snap
fi
if [ -n "${unmet}" ]; then
  exit 1
fi

# First we install packages we need; a fresh cloud image may have no
# package lists yet
apt-get update --error-on=any
missing=""
if [ ! -x "$(command -v docker)" ]; then
  missing="${missing} docker.io"
fi
if [ ! -x "$(command -v iw)" ]; then
  missing="${missing} iw"
fi
if ! modinfo mac80211_hwsim > /dev/null 2>&1; then
  missing="${missing} linux-modules-extra-$(uname -r)"
fi
aws_snap=""
if [ -n "${on_ec2}" ] && [ ! -x "$(command -v aws)" ]; then
  # Ubuntu 24.04 has no awscli package; AWS's snap stands in for it
  if apt-cache policy awscli | sed -n 's/^  Candidate: //p' | grep -qv '^(none)$'; then
    missing="${missing} awscli"
  else
    aws_snap=1
  fi
fi
if [ -n "${missing:-}" ]; then
  # shellcheck disable=SC2086
  apt-get -y install ${missing}
fi
if [ -n "${aws_snap}" ]; then
  snap install aws-cli --classic
fi

# Before pulling anything: with the remapping on, docker keeps its images
# apart from the ones it had without it
"$(dirname "${0}")"/docker_userns_remap

# Then we setup our startup sequence
[ ! -d '/etc/local.d' ] && mkdir -p /etc/local.d
for i in "$(pwd)"/../startup/*; do
  if [ "${i}" = "$(pwd)/../startup/*" ]; then
    continue
  fi
  # RFHS runs the sdr sender seperately but this does work
  if [ "${i}" = "$(pwd)/../startup/07_rfctf-sdr.start" ]; then
    continue
  fi
  # only for the physical display box
  if [ "${i}" = "$(pwd)/../startup/08_fosphor_knob.start" ]; then
    continue
  fi
  ln -snf "${i}" /etc/local.d/
done

if [ ! -f '/etc/rc.local' ]; then
  cat <<- EOF > /etc/rc.local
#!/bin/sh
for i in /etc/local.d/*.start; do
  if [ "\${i}" = '/etc/local.d/*.start' ]; then
    continue
  fi
  if [ -x "\${i}" ]; then
    "\${i}"
  fi
done
EOF
fi

if [ ! -x '/etc/rc.local' ]; then
  chmod 755 /etc/rc.local
fi

if [ ! -f '/etc/systemd/system/rc-local.service' ]; then
  cat <<- EOF > /etc/systemd/system/rc-local.service
[Unit]
Description=/etc/rc.local Support
ConditionPathExists=/etc/rc.local

[Service]
ExecStart=/etc/rc.local start
TimeoutSec=0
StandardOutput=tty
RemainAfterExit=yes
SysVStartPriority=99

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
fi

# pull image: docker pull, tried three times, as registries have bad moments
pull() {
  tries=0
  until docker pull "${1}"; do
    tries=$((tries + 1))
    if [ "${tries}" -ge 3 ]; then
      return 1
    fi
    sleep 30
  done
}

# Now we grab the docker images we need
for i in "$(pwd)"/../startup/0*; do
  if [ "${i}" = "$(pwd)/../startup/0*" ]; then
    continue
  fi
  unset image
  image="$(grep CONTAINER_IMAGE "${i}" | cut -d'"' -f2)"
  if [ "${image}" = 'rfhs/rfctf-sdr' ]; then
    continue
  fi
  if [ "${image}" = 'rfhs/fosphor_knob' ]; then
    continue
  fi
  if [ -z "${image:-}" ]; then
    continue
  fi
  printf 'Pulling %s\n' "${image}"
  pull "${image}"
done
pull certbot/certbot
pull nginx

# Prep some useful info for users logging in
get_homedir() {
  if [ -z "${1:-}" ]; then
    printf 'get_homedir called without arguement, fatal.\n'
    exit 1
  fi
  awk -F':' "/${1}/{print \$6}" /etc/passwd
}

get_shell() {
  if [ -z "${1:-}" ]; then
    printf 'get_shell called without arguement, fatal.\n'
    exit 1
  fi
  user_shell="$(awk -F':' "/${1}/{print \$7}" /etc/passwd)"
  if [ "${user_shell:-}" = '/bin/bash' ]; then
    printf '.bashrc'
  elif [ "${user_shell:-}" = '/bin/zsh' ]; then
    printf '.zshrc'
  else
    printf 'Detected unsupported shell %s, please add support for configuring dot file.\n' "${user_shell:-}"
    exit 1
  fi
}

# Make a fake /etc/rfctf-contestant stub
cat <<- EOF > /etc/rfctf-contestant
SQS_RESPONSE_QUEUE=https://sqs.us-east-1.amazonaws.com/666/totally-fake.fifo
FQDN=UNPROVISIONED.contestant.rfhackers.com
TRANSACTION_ID=66666666-6666-6666-6666-666666666666
EOF

dot_file='bad'
if [ ! -d /usr/local/bin ]; then
  mkdir -p /usr/local/bin
fi
cp "$(dirname "${0}")"/rfctf_status /usr/local/bin
if [ -n "${SUDO_USER:-}" ]; then
  if ! grep rfctf_status "$(get_homedir "${SUDO_USER}")/$(get_shell "${SUDO_USER}")"; then
    echo '/usr/local/bin/rfctf_status' >> "$(get_homedir "${SUDO_USER}")/$(get_shell "${SUDO_USER}")"
    dot_file='good'
  else
    dot_file='good'
  fi
elif [ -n "${USER:-}" ]; then
  if ! grep rfctf_status "$(get_homedir "${USER}")/$(get_shell "${USER}")"; then
    echo '/usr/local/bin/rfctf_status' >> "$(get_homedir "${USER}")/$(get_shell "${USER}")"
    dot_file='good'
  else
    dot_file='good'
  fi
fi
if ! grep rfctf_status "$(get_homedir root)/$(get_shell root)"; then
  echo '/usr/local/bin/rfctf_status' >> "$(get_homedir root)/$(get_shell root)"
  dot_file='good'
else
  dot_file='good'
fi
if [ "${dot_file}" = 'bad' ]; then
  printf "Unable to automatically add profile_status to your shell environment.  You should call 'profile_status' from your shell's dot file\n"
  exit 1
fi

# add user to docker group
if [ -n "${SUDO_USER:-}" ]; then
  if ! grep "${SUDO_USER}" /etc/group 2>&1 | grep -q 'docker:x:' 2> /dev/null; then
    gpasswd -a "${SUDO_USER}" docker
  fi
elif [ -n "${USER:-}" ]; then
  if ! grep "${USER}" /etc/group 2>&1 | grep -q 'docker:x:' 2> /dev/null; then
    gpasswd -a "${USER}" docker
  fi
fi
exit 0
