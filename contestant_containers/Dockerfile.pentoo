FROM scratch AS portage
ADD portage_and_overlay.tar.xz /

FROM docker.io/pentoolinux/pentoo-core:latest
# setup FEATURES and use flags
RUN echo 'FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox"' >> /etc/portage/make.conf
  #sed -i 's#-livecd#-drivers -pulseaudio -vnc opencl#' /etc/portage/make.conf && \
  # --security=insecure is only needed for go
# --rebuilt-binaries=n and no --update, or pentoo-core's packages get reinstalled into this layer
RUN --mount=type=bind,from=portage,source=/var/db/repos,target=/var/db/repos \
  sed -i 's#-livecd#-drivers  -vnc opencl#' /etc/portage/make.conf && \
  echo 'pentoo/pentoo-wireless pentoo-full' >> /etc/portage/profile/package.use/pentoo && \
  echo 'pentoo/pentoo-radio -bladerf -bluetooth -hackrf -limesdr -plutosdr -rtlsdr' >> /etc/portage/profile/package.use/pentoo && \
  echo 'net-wireless/aircrack-ng **' >> /etc/portage/profile/package.accept_keywords && \
  echo 'xfce-base/xfce4-meta -upower' >> /etc/portage/profile/package.use/pentoo && \
  # go is needed for termshark but has a dep loop
  if [ -z "$(portageq match / 'dev-lang/go')" ]; then emerge -1 --rebuilt-binaries=n dev-lang/go-bootstrap; fi && \
  emerge --getbinpkgonly=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) dev-lang/go --oneshot && \
  # install binary web browsers so they are preferred
  echo 'ACCEPT_LICENSE="google-chrome" ' >> /etc/portage/make.conf && \
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) www-client/google-chrome www-client/firefox-bin --oneshot && \
  # install the base distro stuff, includes wpa_supplicant
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) --deep --newuse pentoo/pentoo-core pentoo/pentoo-desktop && \
  # install the distro wireless metapackage for aircrack-ng, hostapd, freeradius, kismet, mdk3, reaver (and pixiewps), wifite, asleap, hcxtools, hcxdumptool hcxtools
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) --deep --newuse pentoo/pentoo-wireless && \
  # sox is busted, not sure why, get an error
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=1 --deep --newuse media-sound/sox && \
  # install the distro radio metapackage for gnuradio, gqrx, and gr-osmosdr
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) --deep --newuse pentoo/pentoo-radio && \
  # install the distro opencl stuff because gentoo is weird
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) --deep --newuse dev-libs/pocl --oneshot && \
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) --deep --newuse pentoo/pentoo-opencl && \
  # install the additional packages we want, missing gr-lora_sdr and nrsc5
  emerge --getbinpkg=y --buildpkg=n --rebuilt-binaries=n --jobs=$(nproc) --deep --newuse app-crypt/hashcat www-apps/novnc x11-misc/x11vnc net-analyzer/wireshark net-analyzer/termshark app-misc/tmux app-misc/screen net-analyzer/tcpdump net-analyzer/nmap media-radio/fldigi media-radio/qsstv media-radio/wsjtx_improved net-wireless/urh && \
  # also depclean bdeps and deps
  emerge --depclean --with-bdeps=n --jobs=$(nproc) && \
  # rm all the files we don't want
  rm -rf /var/cache/{binpkgs,distfiles,edb/binhost,edb/dep}/* /usr/share/doc/* /usr/lib/debug && \
  sed -i 's/#X11Forwarding no/X11Forwarding yes/' /etc/ssh/sshd_config
RUN \
  # make sure the menus exist
  genmenu.py -x

# Expose needed ports
EXPOSE 22/tcp
EXPOSE 8080/tcp

# Set operable environment
ENV DISPLAY=:0

COPY files/2026-2027_cyberpunk.words /root/2026-2027_cyberpunk.words
COPY files/supervisord-pentoo.conf /etc/supervisord.conf
COPY files/contestant-checker /usr/local/sbin/contestant-checker
COPY files/contestant_start /usr/local/sbin/contestant_start

WORKDIR /root
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf", "--pidfile", "/run/supervisord.pid"]
ENTRYPOINT []

HEALTHCHECK --interval=300s --start-period=120s --retries=2 CMD /usr/local/sbin/contestant-checker
