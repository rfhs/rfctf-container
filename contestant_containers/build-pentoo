#!/bin/sh
set -e
missing_tools=""
for tool in date docker hostname sleep sudo; do
  command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool}"
done
if [ -n "${missing_tools}" ]; then
  printf '%s: required commands not found:%s\n' "${0##*/}" "${missing_tools}" >&2
  exit 1
fi
if [ "$(date -r portage_and_overlay.tar.xz +%s)" -lt "$(date -d "7 days ago" +%s)" ]; then
  printf "portage_and_overlay.tar.xz is too old, aborting for safety\n"
  exit 1
fi
VERS="0.52"
DISTRO="pentoo"
#./make_gentoo_cache.sh
if [ -n "$(docker ps --filter name="rfhs-${DISTRO}-ci" --format '{{ .ID }}' )" ]; then
	echo "Found existing rfhs-${DISTRO}-ci container... QUITTING"
	exit 1
fi
docker pull docker.io/pentoolinux/pentoo-core:latest
docker build --no-cache . --progress=plain -f "Dockerfile.${DISTRO}" -t rfhs/${DISTRO}:${VERS}
docker tag rfhs/${DISTRO}:${VERS} rfhs/${DISTRO}:latest
. ../startup/rfhs-helpers.sh
# docker's own healthcheck runs would race the tests' runs of the checker
# The game's privileges and, as the game gives each contestant, four radios,
# for contestant-checker excessive's wifi tests
(
  IFS='
'
  set -f
  # shellcheck disable=SC2046
  docker run -d --rm --no-healthcheck --name "rfhs-${DISTRO}-ci" $(contestant_docker_args) "rfhs/${DISTRO}"
)
sudo ../tools/give_hwsim_radios.sh "rfhs-${DISTRO}-ci" 4
STARTUP_WAIT="${STARTUP_WAIT:-30}"
printf "Sleeping %s seconds so services have time to start up...\n" "${STARTUP_WAIT}"
sleep "${STARTUP_WAIT}"
if ../tools/bench_healthcheck.sh -t 100 "rfhs-${DISTRO}-ci" \
  && docker exec "rfhs-${DISTRO}-ci" /usr/local/sbin/contestant-checker excessive \
  && ./tests/test_healthcheck.sh "rfhs-${DISTRO}-ci"; then
  docker stop "rfhs-${DISTRO}-ci"
  if [ "$(hostname)" = "Nu" ] ; then
    docker push rfhs/${DISTRO}
    docker push rfhs/${DISTRO}:${VERS}
    docker push rfhs/${DISTRO}:latest
  fi
  exit_code=0
else
  if [ "$(hostname)" = "Nu" ] ; then
    printf "contestant-checker failed!\n"
    docker stop "rfhs-${DISTRO}-ci"
  else
    printf "contestant-checker failed, rfhs-%s-ci is still running for debugging...\n" "${DISTRO}"
  fi
  exit_code=1
fi
exit ${exit_code}
