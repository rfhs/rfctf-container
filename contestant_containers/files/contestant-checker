#!/bin/sh

set -eu

if [ "${1:-}" = "excessive" ]; then
  # needs file command...: names the commands file runs that aren't installed
  needs() {
    file="${1}"
    shift
    missing_tools=""
    for tool in "$@"; do
      command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool}"
    done
    if [ -n "${missing_tools}" ]; then
      printf '%s: required commands not found:%s\n' "${file}" "${missing_tools}"
      unmet=1
    fi
  }
  unmet=""
  # this healthcheck and these tests, besides the tools checked below
  needs contestant-checker awk cat curl grep ldd nice notify-send python3 rm ss supervisorctl tail tee timeout wc
  # contestant_start, which supervisord runs to start the services in order;
  # it doesn't check for itself, so a command it starts to run goes here
  needs contestant_start awk mkdir sleep supervisorctl
  if [ -n "${unmet}" ]; then
    exit 1
  fi
  printf 'Checking the tools are installed and their libraries resolve...\n'
  missing=""
  broken=""
  # every distribution packages these
  for tool in aircrack-ng airodump-ng aireplay-ng airmon-ng asleap bully hashcat hcxdumptool \
    hcxpcapngtool hostapd-mana hostapd-wpe iw kismet macchanger mdk4 nmap pixiewps reaver tcpdump \
    termshark tshark wash wifite wireshark wpa_passphrase wpa_supplicant; do
    if ! tool_path="$(command -v "${tool}")"; then
      missing="${missing} ${tool}"
    elif ldd "${tool_path}" 2> /dev/null | grep -q 'not found'; then
      broken="${broken} ${tool}"
    fi
  done
  # only some distributions package these
  for tool in fldigi freeradius-wpe gnuradio-companion gqrx mdk3 qsstv urh wsjtx; do
    if tool_path="$(command -v "${tool}")" && ldd "${tool_path}" 2> /dev/null | grep -q 'not found'; then
      broken="${broken} ${tool}"
    fi
  done
  if [ -n "${missing}" ]; then
    printf 'Missing:%s\n' "${missing}"
  fi
  if [ -n "${broken}" ]; then
    printf 'Unresolved libraries:%s\n' "${broken}"
  fi
  if [ -n "${missing}${broken}" ]; then
    exit 1
  fi
  printf 'Test passed\n'
  printf 'Testing wpa_passphrase...\n'
  if ! wpa_passphrase hashcat-essid 'hashcat!' | grep -q 'psk=88f43854ae7b1624fc2ab7724859e795130f4843c7535729e819cf92f39535dc$'; then
    printf 'wpa_passphrase did not derive the expected PSK\n'
    exit 1
  fi
  printf 'Test passed\n'
  printf 'Testing tshark has the 802.11 and EAPOL dissectors...\n'
  if [ "$(tshark -G protocols 2> /dev/null | awk -F'\t' '$3 == "wlan" || $3 == "eapol"' | wc -l)" -ne 2 ]; then
    printf 'tshark is missing the wlan or eapol dissector\n'
    exit 1
  fi
  printf 'Test passed\n'
  printf 'Testing wifite starts...\n'
  if ! timeout 60 wifite --help > /dev/null 2>&1; then
    timeout 60 wifite --help 2>&1 | tail -n 5 || true
    printf 'wifite --help failed\n'
    exit 1
  fi
  printf 'Test passed\n'
  printf 'Testing notify-send...\n'
  notify-send 'Notify-send' 'Works' --icon=dialog-information
  printf 'Test passed\n'
  printf 'Testing aircrack-ng for 30 seconds...\n'
  nice -n 19 aircrack-ng -S -Z 30
  printf 'Test passed\n'
  # hashcat's example WPA hash, for the passphrase hashcat!; CUDA and HIP are
  # ignored so it has to crack it with OpenCL
  printf 'Testing hashcat with OpenCL...\n'
  if ! hashcat_out="$(printf 'password\nhashcat!\n' | timeout 900 nice -n 19 hashcat -m 22000 -a 0 \
    --backend-ignore-cuda --backend-ignore-hip --session contestant-checker --restore-disable \
    --potfile-disable --logfile-disable --quiet \
    'WPA*01*4d4fe7aac3a2cecab195321ceb99a7d0*fc690c158264*f4747f87f9f4*686173686361742d6573736964***' 2>&1)" \
    || ! printf '%s\n' "${hashcat_out}" | grep -q ':hashcat!$'; then
    printf '%s\n' "${hashcat_out:-}"
    printf 'hashcat could not crack a known WPA hash with OpenCL\n'
    exit 1
  fi
  printf 'Test passed\n'
fi

# Only a failing pass writes /root/HEALTHCHECK_DEGRADED, and it overwrites the
# last one's, so the file holds one pass worth of errors and its existence
# means the last pass failed. Its first line names the failure. Every failing
# pass notifies, so the contestant can't miss it.
degraded() {
  notify-send 'Healthcheck' "Failed\n$(cat /root/HEALTHCHECK_DEGRADED)" --icon=dialog-error || true
  exit 1
}

# Next we check runtime services think they are running
# sshdir and sshkeys don't have to be checked, only sshd
# supervisorctl takes a lot of CPU to start, so this asks supervisord over
# XML-RPC, on the server supervisorctl uses. awk pairs each process's name
# with its statename and description, and on a failure writes the report,
# with the lines supervisorctl status would print
if ! curl -fsS --max-time 30 -H 'Content-Type: text/xml' http://127.0.0.1:9001/RPC2 \
  --data-binary '<?xml version="1.0"?><methodCall><methodName>supervisor.getAllProcessInfo</methodName></methodCall>' 2>&1 \
  | awk -v report=/root/HEALTHCHECK_DEGRADED '
    function out(line) { print line; print line > report }
    function unxml(s) { gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&quot;/, "\"", s); gsub(/&amp;/, "\\&", s); return s }
    /<params>/ { answered = 1 }
    !answered { gsub(/<[^>]*>/, ""); if ($0 != "") said[++lines] = $0; next }
    /<name>/ { key = $0; gsub(/<[^>]*>/, "", key); getline; gsub(/<[^>]*>/, "")
      if (key == "name") name = $0; else if (key == "statename") state = $0; else if (key == "description") desc = $0 }
    /<\/struct>/ { if (name != "") { states[name] = state; descs[name] = desc }; name = state = desc = "" }
    END { if (!answered) {
        out("supervisord did not answer on 127.0.0.1:9001")
        for (i = 1; i <= lines; i++) out(said[i])
        exit 1 }
      n = split("sshd X11 xfce x11vnc novnc", want, " ")
      for (i = 1; i <= n; i++) if (!(want[i] in states) || states[want[i]] != "RUNNING") down = down (down == "" ? "" : ", ") want[i]
      if (down == "") exit 0
      out("Not running: " down)
      for (i = 1; i <= n; i++)
        if (want[i] in states) out(sprintf("%-33s%-10s%s", want[i], states[want[i]], unxml(descs[want[i]])))
        else out(sprintf("%-33s%-10s%s", want[i], "ERROR", "(no such process)"))
      exit 1 }'; then
  degraded
fi

# Then we check the expected listening ports are actually listening
listening=" $(ss -Hnlt | awk '{ printf "%s ", $4 }')"
for port in 22 8080; do
  case "${listening}" in
    *" 0.0.0.0:${port} "*) ;;
    *)
      { printf 'Nothing is listening on port %s\n' "${port}"; ss -nltp; } | tee /root/HEALTHCHECK_DEGRADED
      degraded
      ;;
  esac
done

if [ "${1:-}" = "excessive" ]; then
  printf 'Testing noVNC serves its page and x11vnc answers...\n'
  if ! curl -fsS -o /dev/null http://127.0.0.1:8080/vnc.html; then
    printf 'noVNC did not serve vnc.html\n'
    exit 1
  fi
  if ! python3 -c 'import socket, sys; s = socket.create_connection(("127.0.0.1", 5900), 10); sys.exit(not s.recv(12).startswith(b"RFB "))'; then
    printf 'x11vnc did not send an RFB greeting\n'
    exit 1
  fi
  printf 'Test passed\n'
  printf 'Testing the healthcheck fails with novnc stopped and recovers...\n'
  supervisorctl stop novnc > /dev/null
  if "${0}" > /dev/null 2>&1 || ! grep -q '^novnc ' /root/HEALTHCHECK_DEGRADED; then
    supervisorctl start novnc > /dev/null || true
    printf 'The healthcheck did not fail with novnc stopped\n'
    exit 1
  fi
  supervisorctl start novnc > /dev/null
  if ! "${0}" > /dev/null 2>&1 || [ -e /root/HEALTHCHECK_DEGRADED ]; then
    printf 'The healthcheck did not recover once novnc was started again\n'
    exit 1
  fi
  printf 'Test passed\n'
fi

printf "Everything looks good.\n"
if [ -f "/root/HEALTHCHECK_DEGRADED" ]; then
  rm /root/HEALTHCHECK_DEGRADED
  notify-send 'Healthcheck' 'Recovered' --icon=dialog-information || true
fi
true
